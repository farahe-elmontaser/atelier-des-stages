# Copiez ce fichier en ".env" puis remplissez ce que vous avez.
# Tout est optionnel : sans cles, l'application tourne en mode DEMO.

# --- Mode demo (offres d'exemple dans data/demo_offres.json) ---
DEMO_MODE=true

# --- Scheduler : toutes les combien de minutes on verifie les offres ---
INTERVALLE_MINUTES=60

# --- Web scraping (requests + BeautifulSoup) ---
SCRAPING_ACTIF=true
# nombre d offres lues (chaque offre = 1 page detail visitee)
SCRAPING_MAX_OFFRES=20
# secondes d attente entre deux requetes
SCRAPING_PAUSE=1

# --- Ollama (LLM local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- API Adzuna : https://developer.adzuna.com ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_PAYS=fr,ca
ADZUNA_MOTS_CLES=stage

# --- API France Travail : https://francetravail.io ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_MOTS_CLES=stage

# --- Job Bank (Canada) : deposez le fichier CSV telecharge depuis open.canada.ca ---
JOB_BANK_CSV=data/job_bank.csv

# --- E-mail (Gmail : creez un "mot de passe d'application") ---
# Si vide, les e-mails sont simplement affiches dans le terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Securite ---
# Adresses autorisees a appeler l'API depuis un navigateur
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Adresse du backend, utilisee pour le lien "Se desinscrire" des e-mails
URL_PUBLIQUE=http://localhost:8000
# Mot de passe pour lancer /api/refresh depuis une autre machine (vide = seulement en local)
ADMIN_TOKEN=
